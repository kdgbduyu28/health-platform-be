# Edge Function secrets for send-push and calendar-feed. Copy to .env (gitignored), fill in, then:
#   supabase secrets set --env-file supabase/functions/.env
#
# A VAPID key pair: npx web-push generate-vapid-keys
# The public half must also be in the apps (SupabaseConfig.vapidPublicKey).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services (Google, Mozilla, Apple) see on every push.
VAPID_SUBJECT=mailto:you@example.com
# Any long random string; the same value goes in Vault as push_webhook_secret.
PUSH_WEBHOOK_SECRET=
# calendar-feed, optional: the patient app's address. Each calendar event then
# links to the visit in the app.
PATIENT_APP_URL=
